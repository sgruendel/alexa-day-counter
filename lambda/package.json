{
    "name": "alexa-day-counter",
    "version": "2.3.0",
    "description": "Alexa Skill for persistent counting of events per day",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "reinstall": "rm -rf ./node_modules && npm install",
        "test": "node --env-file-if-exists=.env ./node_modules/c8/bin/c8.js --reporter=lcov --reporter=text mocha --timeout 5000 --file test/setup.js",
        "lambda:zip": "zip -r /tmp/dayCounter.zip node_modules/ package* *.js",
        "lambda:deploy": "npm run lambda:zip && aws lambda update-function-code --function-name dayCounter --zip-file fileb:///tmp/dayCounter.zip"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sgruendel/alexa-day-counter.git"
    },
    "author": "Stefan Gründel",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/sgruendel/alexa-day-counter/issues"
    },
    "homepage": "https://github.com/sgruendel/alexa-day-counter#readme",
    "dependencies": {
        "ask-sdk-core": "^2.14.0",
        "ask-sdk-model": "^1.86.0",
        "dynamoose": "^4.2.0",
        "i18next": "^26.4.1",
        "i18next-sprintf-postprocessor": "^0.2.2",
        "moment-timezone": "^0.6.3",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.9",
        "@types/node": "^24.13.3",
        "c8": "^12.0.0",
        "chai": "^6.2.2",
        "eslint": "^10.9.1",
        "globals": "^17.12.0",
        "mocha": "^12.0.0"
    }
}
